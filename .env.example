# Copiá este fichero a .env.local y completalo. .env.local no se sube al repo.

# MongoDB. Si ya tenés uno en el 27017 (de otro proyecto), usá su cadena:
# esta app usa su propia base ("mailing").
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=mailing

# Firma de las sesiones y de los enlaces de los mails. Un texto largo al azar:
# openssl rand -base64 32
JWT_SECRET=

# Correo en desarrollo: MailHog (docker compose up -d). Los mails no salen:
# se ven en http://localhost:8025
MAILHOG_HOST=localhost
MAILHOG_PORT=1025

# Correo real (la versión publicada). Si están, mandan sobre MAILHOG_*.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=tu-cuenta@gmail.com

# Mails por minuto que manda el worker (respetá el límite de tu SMTP).
# MAIL_RATE_PER_MINUTE=120

# Demo pública: si está, las campañas solo salen hacia estos emails o
# dominios (separados por coma). El resto queda "omitido".
# DEMO_ALLOWED_RECIPIENTS=tu-cuenta@gmail.com,@ejemplo.com

# Dominio público, para los enlaces de los mails. Local: no hace falta.
# APP_URL=https://cartero.onrender.com

# El dueño de la organización de ejemplo que crea `npm run seed`.
SEED_OWNER_EMAIL=tu-email@ejemplo.com
